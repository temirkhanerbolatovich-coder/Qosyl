{
  "name": "student-project-marketplace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "demo": "node scripts/demo.mjs",
    "db:backup": "node scripts/backup-db.mjs",
    "build": "prisma generate && next build",
    "start": "node scripts/run-platform.mjs",
    "worker:lifecycle": "node --conditions=react-server --import tsx scripts/project-lifecycle-worker.ts",
    "worker:lifecycle:once": "node --conditions=react-server --import tsx scripts/project-lifecycle-worker.ts --once",
    "worker:content": "node --conditions=react-server --import tsx scripts/content-worker.ts",
    "worker:content:once": "node --conditions=react-server --import tsx scripts/content-worker.ts --once",
    "test:content": "node scripts/test-content.mjs",
    "test:leads": "node scripts/test-leads.mjs",
    "test:lifecycle": "node scripts/test-lifecycle.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src prisma scripts tests *.json *.ts *.mjs docs/*.md README.md",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:ui": "node scripts/run-ui-quality.mjs",
    "test:ui:baseline": "node scripts/run-ui-quality.mjs --baseline",
    "ui:tokens": "node scripts/generate-design-tokens.mjs && node scripts/check-design-tokens.mjs",
    "test:db": "node scripts/check-database.mjs",
    "api:generate": "tsx scripts/generate-api-spec.ts",
    "api:check": "tsx scripts/generate-api-spec.ts --check",
    "db:local": "node scripts/local-db.mjs",
    "db:stop": "node scripts/local-db.mjs stop",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "npm run db:local && prisma generate && npm run db:migrate && npm run db:seed",
    "admin": "tsx scripts/admin.ts",
    "mail": "node scripts/read-mail.mjs",
    "mail:check": "tsx scripts/check-mail.ts",
    "opportunities:collect": "node --conditions=react-server --import tsx scripts/collect-opportunities.ts --collect"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.12",
    "cheerio": "^1.2.0",
    "dotenv": "18.0.9",
    "fast-xml-parser": "5.11.2",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "nodemailer": "10.2.1",
    "pg": "8.20.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
