{
  email {$ACME_EMAIL}
  admin off
}

{$PUBLIC_HOST} {
  encode zstd gzip
  header -Server
  # Search Console URL-prefix ownership files live in a dedicated read-only directory.
  @googleVerification path_regexp ^/google[a-zA-Z0-9]+\.html$
  handle @googleVerification {
    root * /srv/qosyl-verification
    file_server
  }
  @attachment path_regexp ^/api/projects/[^/]+/attachments$
  @avatarUpload {
    method POST
    path /api/profile/avatar
  }
  @other {
    not path_regexp ^/api/projects/[^/]+/attachments$
    not {
      method POST
      path /api/profile/avatar
    }
  }
  request_body @attachment {
    max_size 5242880
  }
  request_body @avatarUpload {
    max_size 2097152
  }
  request_body @other {
    max_size 128KB
  }
  reverse_proxy app:3000 {
    # The app has no published port and only this proxy supplies the client address.
    header_up X-Forwarded-For {remote_host}
    header_up X-Real-IP {remote_host}
  }
  # No access log: verification/reset links and cookies must not reach request logs.
}
