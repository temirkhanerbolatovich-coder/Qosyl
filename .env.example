DATABASE_URL=postgresql://marketplace:replace-with-generated-password@127.0.0.1:55432/student_marketplace
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
# Optional Google OAuth web client; keep the secret out of Git.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LOCAL_DEV_MODE=true
DEMO_ENABLED=true
# Production requires LOCAL_DEV_MODE=false, DEMO_ENABLED=false and verified mail delivery.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# Optional read-only Threads search. Keep disabled until the app/user search access is confirmed.
THREADS_SEARCH_ENABLED=false
THREADS_ACCESS_TOKEN=
# Local Qosyl inbox only; individual saved searches remain off until the account opts in.
OPPORTUNITY_NOTIFICATIONS_ENABLED=true
OPPORTUNITY_NOTIFICATIONS_INTERVAL_MS=60000
OPPORTUNITY_NOTIFICATIONS_BATCH_SIZE=10
